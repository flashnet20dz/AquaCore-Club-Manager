# ═══════════════════════════════════════════════════════════
# Example .env file for AquaCore Club Manager
# Copy to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════

# ─── للتطوير المحلي (SQLite) ───────────────────────────────
# DATABASE_URL="file:./dev.db"

# ─── للإنتاج (Vercel + Neon PostgreSQL) ───────────────────
# Neon PostgreSQL database (pooled — للتطبيق)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Neon direct connection (للـ migrations فقط)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# ─── NextAuth.js ───────────────────────────────────────────
# أنشئه بـ: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-at-least-32-chars"

# للتطوير المحلي فقط (Vercel يكتشفها تلقائياً)
# NEXTAUTH_URL="http://localhost:3000"

# الرابط العام للتطبيق (يُستخدم في رسائل بوابة المنخرط)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Cloudinary (رفع الصور) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── الأمان ───────────────────────────────────────────────
# سر حماية نقاط cron — ولّده بـ: openssl rand -hex 32
CRON_SECRET=

# إنشاء حساب مدير أولي على قاعدة بيانات فارغة فقط.
# اتركه فارغاً في الإنتاج؛ عند الإعداد الأول اضبطه =true
SEED_DEFAULT_ADMIN=

# سر توقيع أكواد التفعيل — خادمي فقط
ACTIVATION_HMAC_SECRET=

# ─── ميزات الموجة الأولى ──────────────────────────────────
# سر توقيع روابط بوابة المنخرط (ولّده بـ: openssl rand -hex 32)
MEMBER_PORTAL_SECRET=

# أتمتة WhatsApp — اتركها فارغة للعمل بروابط wa.me اليدوية
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
