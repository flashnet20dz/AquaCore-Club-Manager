# ═══════════════════════════════════════════════════════════
# Example .env file for RCS Swim Manager
# Copy to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════

# Neon PostgreSQL database (pooled for production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connection_limit=1"

# Neon direct connection (for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# NextAuth.js secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-here-at-least-32-chars"

# Optional: Vercel auto-detects these, but useful for local dev
# NEXTAUTH_URL="http://localhost:3000"

# ═══ Cloudinary (رفع الصور) ═══
# ⚠️ كان هنا مفتاح حقيقي مسرّب في المستودع — قم بتدويره من لوحة Cloudinary فوراً
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ═══ الأمان ═══
# سر حماية نقاط cron — تُرسل في ترويسة x-cron-secret من خدمة الجدولة
# ولّده بـ: openssl rand -hex 32
CRON_SECRET=

# إنشاء حساب مدير أولي على قاعدة بيانات فارغة فقط.
# اتركه فارغاً في الإنتاج؛ عند الإعداد الأول اضبطه =true وستُطبع
# كلمة سر عشوائية قوية في سجل الخادم مرة واحدة.
SEED_DEFAULT_ADMIN=

# سر توقيع أكواد التفعيل — خادمي فقط، لا يُضبط في العميل إطلاقاً
ACTIVATION_HMAC_SECRET=
